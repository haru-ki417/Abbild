<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Abbild</RootNamespace>
    <AssemblyName>Abbild</AssemblyName>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RollForward>Major</RollForward>
    <TieredPGO>true</TieredPGO>
    <!-- MonoGame の native ライブラリ（SDL2 / OpenAL）を出力に含める -->
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.6.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Abbild.Core\Abbild.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Content\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp" />
  </ItemGroup>
</Project>
